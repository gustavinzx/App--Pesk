{
  "name": "pesk",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.12",
    "expo-status-bar": "~58.0.3",
    "firebase": "^13.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.3.0",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.11",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "dev:backend": "npm --prefix src/backend run dev",
    "test:backend": "npm --prefix src/backend test",
    "typecheck:backend": "npm --prefix src/backend run typecheck",
    "build:backend": "npm --prefix src/backend run build"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/src/backend/server/dist/"
    ]
  },
  "private": true
}
