# ==============================================================================
# Configurações do Firebase - Pesk
# Obtenha estas credenciais no Firebase Console (Configurações do Projeto > Geral > Seus apps > App da Web)
# ==============================================================================
EXPO_PUBLIC_FIREBASE_API_KEY=coloque_sua_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=seu_app_id
