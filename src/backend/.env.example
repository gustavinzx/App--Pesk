# Firebase project ID used by Firebase Admin SDK
FIREBASE_PROJECT_ID=seu-project-id

# Optional: local service-account JSON path. In production, prefer ADC/workload identity.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# API listener
HOST=0.0.0.0
PORT=3000

# Comma-separated allowed browser origins. Native apps are not subject to CORS.
API_CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081

# Fotos ficam no disco local do backend (diretório ignorado pelo Git)
LOCAL_PHOTOS_DIR=local-data/fotos
# URL que o cliente consegue acessar; em dispositivo físico use o IP da máquina
API_PUBLIC_URL=http://localhost:3000
