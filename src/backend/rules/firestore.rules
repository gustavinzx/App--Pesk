rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // O acesso ao perfil ocorre pela API com Firebase Admin SDK; clientes não acessam diretamente.
    match /usuarios/{uid} {
      allow read, write: if false;
    }

    // Bloqueia qualquer outro acesso não explicitamente permitido
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
